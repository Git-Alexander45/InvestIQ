# InvestIQ configuration. Copy to .env (scripts/windows/install.ps1 does this and fills in random
# secrets). .env is git-ignored: never commit it. Owner preferences (research time, budget, risk
# limits, email address...) are set in the dashboard, not here.

INVESTIQ_ENV=production

# --- Database (Docker Compose PostgreSQL bound to 127.0.0.1) ---
INVESTIQ_DB_NAME=investiq
INVESTIQ_DB_USER=investiq
INVESTIQ_DB_PASSWORD=change-me-random
INVESTIQ_DB_PORT=5432
INVESTIQ_DATABASE_URL=postgresql+psycopg://investiq:change-me-random@127.0.0.1:5432/investiq
# Backups: "docker" runs pg_dump inside the database container (no client tools needed on Windows)
INVESTIQ_PG_TOOLS_MODE=docker

# --- Local API (never expose beyond this computer) ---
INVESTIQ_API_HOST=127.0.0.1
INVESTIQ_API_PORT=8765
# Random token shared by the API and the dashboard's server-side proxy (investiq gen-token)
INVESTIQ_API_TOKEN=
INVESTIQ_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Host names the dashboard answers to (protects against DNS rebinding). Default:
# INVESTIQ_DASHBOARD_HOSTS=127.0.0.1:3000,localhost:3000,[::1]:3000

# --- Folders (default: inside the InvestIQ folder) ---
# INVESTIQ_DATA_DIR=C:\InvestIQ\data
# INVESTIQ_BACKUP_DIR=C:\InvestIQ\backups
# INVESTIQ_OUTBOX_DIR=C:\InvestIQ\outbox

# --- AI (optional; without it quantitative research still runs) ---
# Hard monthly limit is set in Settings (default 5 CAD) and is never raised automatically.
ANTHROPIC_API_KEY=

# --- Market data (at least one price provider is needed for real research) ---
# Financial Modeling Prep: prices, fundamentals, ETF holdings, dividends, news (paid plans for full coverage)
INVESTIQ_FMP_API_KEY=
# Twelve Data: prices incl. intraday (free tier is rate-limited; check licence for your use)
INVESTIQ_TWELVEDATA_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with contact details, e.g. "InvestIQ personal research you@example.com"
INVESTIQ_SEC_USER_AGENT=

# --- Email (optional; without it reports are saved to the outbox folder) ---
INVESTIQ_EMAIL_FROM=
# Resend (https://resend.com): needs a verified sender domain
INVESTIQ_RESEND_API_KEY=
# or SMTP (e.g. Gmail with an app password)
INVESTIQ_SMTP_HOST=
INVESTIQ_SMTP_PORT=587
INVESTIQ_SMTP_USERNAME=
INVESTIQ_SMTP_PASSWORD=
INVESTIQ_SMTP_STARTTLS=true

# --- Development only ---
INVESTIQ_ALLOW_SYNTHETIC_DATA=false
INVESTIQ_SCHEDULER_ENABLED=true
INVESTIQ_LOG_LEVEL=INFO
